ANTHROPIC_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-openai-key  # for other models
# BRAVE_API_KEY=your-brave-api-key
# COGITO_PROFILE=full  # core profile: stable | learning | full
# COGITO_MODE=full     # deprecated alias (still supported)
# COGITO_HOME=/absolute/path/to/.cogito  # optional persistent data root (~/... also supported)
# COGITO_KNOWLEDGE_GAP_THRESHOLD=0.7
# COGITO_ALLOW_SKILL_WRITE=0  # set to 0 to disable writing generated tools
# COGITO_INDEX_REFRESH_MS=900000
# COGITO_HEARTBEAT_MS=0

# Advanced overrides (prefer COGITO_PROFILE)
# COGITO_ENABLE_QMD=1
# COGITO_ENABLE_REALTIME=1
# COGITO_ENABLE_EMBED=0
# COGITO_ENABLE_CONSOLIDATE=0
# COGITO_ENABLE_LEARNING=0
# COGITO_ENABLE_SKILL_GEN=0
